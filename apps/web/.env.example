# Copy to .env.local and fill in once the Amplify backend is deployed.
# Amplify Gen 2 generates amplify_outputs.json on deploy/sandbox; these are only
# needed for values the client reads directly.

VITE_AWS_REGION=eu-central-1

# Base-map (CRIS-13) style descriptor. Leave unset to use the free public demo
# style; set to the deployed Amazon Location style URL once auth lands (CRIS-24).
# VITE_MAP_STYLE_URL=
